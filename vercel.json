{
  "version": 2,
  "builds": [
    {
      "src": "api/nse-data.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/dhan-data.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/test-dhan.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/manifest.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/save-uploaded-data.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/get-uploaded-data.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/get-uploaded-dates.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/get-latest-signal-date.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/get-signals.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/generate-signals.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/check-date-data.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/test-generate-signals.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/index-history.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/flush-uploaded-data.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/download-nse-csvs.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/nse-data",
      "dest": "/api/nse-data.js"
    },
    {
      "src": "/api/dhan-data",
      "dest": "/api/dhan-data.js"
    },
    {
      "src": "/api/test-dhan",
      "dest": "/api/test-dhan.js"
    },
    {
      "src": "/api/save-uploaded-data",
      "dest": "/api/save-uploaded-data.js"
    },
    {
      "src": "/api/get-uploaded-data",
      "dest": "/api/get-uploaded-data.js"
    },
    {
      "src": "/api/get-uploaded-dates",
      "dest": "/api/get-uploaded-dates.js"
    },
    {
      "src": "/api/get-latest-signal-date",
      "dest": "/api/get-latest-signal-date.js"
    },
    {
      "src": "/api/get-signals",
      "dest": "/api/get-signals.js"
    },
    {
      "src": "/api/generate-signals",
      "dest": "/api/generate-signals.js"
    },
    {
      "src": "/api/check-date-data",
      "dest": "/api/check-date-data.js"
    },
    {
      "src": "/api/test-generate-signals",
      "dest": "/api/test-generate-signals.js"
    },
    {
      "src": "/api/index-history",
      "dest": "/api/index-history.js"
    },
    {
      "src": "/api/flush-uploaded-data",
      "dest": "/api/flush-uploaded-data.js"
    },
    {
      "src": "/api/download-nse-csvs",
      "dest": "/api/download-nse-csvs.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}