# Fix MODE_NONE leak in API responses
# Problem: Using detectedMode instead of finalMode after hard guard allows MODE_NONE to leak into responses
# Solution: Replace all detectedMode references with finalMode after the hard guard

File: api/signals.js

## Issue 1: Line 880 - Stored doc dataUsed construction
Line 880: Use finalMode instead of detectedMode

OLD:
            mode: storedMode || detectedMode,

NEW:
            mode: storedMode || finalMode,

## Issue 2: Line 1029 - INSUFFICIENT_DATA response from generateSignalsForDate
Line 1029: Use finalMode instead of detectedMode

OLD:
            const resolvedMode = result.mode || detectedMode;

NEW:
            const resolvedMode = result.mode || finalMode;

